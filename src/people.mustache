<!DOCTYPE html>
<html lang="en">

<head>
    {{> head}}
    <link rel="stylesheet" type="text/css" href="theme.css">
</head>

<body class="people-page site-shell">
    {{> header}}
<div id="site-scroll" class="site-scroll" role="region" aria-label="Page content" tabindex="0">
    <div class="site-container">
        <main class="people-canvas">
            <h1 class="sr-only">People</h1>

            {{#peopleSections}}
            <section id="{{id}}" class="people-group{{#isAlumni}} people-group--alumni{{/isAlumni}}" aria-labelledby="heading-{{id}}">
                <div class="people-group-header">
                    <h2 id="heading-{{id}}" class="people-group-title">{{title}}</h2>
                </div>
                <div class="people-cards{{#isAlumni}} people-cards--alumni{{/isAlumni}}">
                    {{#members}}
                    <article class="person-card" data-position="{{position}}">
                        {{#url}}<a href="{{.}}" class="person-card-link" target="_blank" rel="noopener noreferrer">{{/url}}
                        {{^url}}<div class="person-card-link">{{/url}}
                            <div class="person-photo">
                                {{#maintainerBadge}}<span class="maintainer-badge {{class}}" role="img" title="{{label}}" aria-label="{{label}}">M{{generation}}</span>{{/maintainerBadge}}
                                <img src="{{image}}" alt="Photo of {{{name}}}"{{#lazyImg}} loading="lazy"{{/lazyImg}}>
                            </div>
                            <div class="person-meta">
                                <p class="person-name"><span class="person-name-text">{{name}}</span></p>
                                <p class="person-role">{{position}}</p>
                            </div>
                        {{#url}}</a>{{/url}}
                        {{^url}}</div>{{/url}}
                    </article>
                    {{/members}}
                </div>
            </section>
            {{/peopleSections}}
        </main>
    </div>
    {{> footer}}
</div>
</body>

</html>
