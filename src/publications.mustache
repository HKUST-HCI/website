<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" type="text/css" href="theme.css">
</head>

<body>
    {{> header}}
    
    <div class="container mx-auto px-4">
        <main class="bg-white rounded-sm shadow-md p-8">
        {{#publications}}
        <section class="mb-4 last:mb-0">
            <h2 class="text-2xl font-title mb-2">{{year}}</h2>
            {{#papers}}
            <article class="my-2 p-3 flex flex-wrap md:flex-nowrap gap-y-2 gap-x-4 hover:bg-gray-50 transition duration-200">
                {{#image}}<figure class="flex-none w-full md:w-1/3">
                    <img src="{{{image}}}" alt="Teaser image of {{{title}}}" class="w-full h-auto">
                </figure>{{/image}}
                <div class="flex-auto">
                    <h3 class="font-title text-lg">{{title}}</h3>
                    <p>
                        {{authorLine}}
                    </p>
                    <p class="publication-meta">
                        <span>In {{venue}}</span>
                        {{#links}}
                        {{#url}}<a href="{{.}}" class="link">URL</a>{{/url}}
                        {{/links}}
                    </p>
                </div>
            </article>
            {{/papers}}
        </section>
        {{/publications}}
        </main>
    </div>

    {{> footer}}
    <script>
    (function () {
        var main = document.querySelector('main');
        if (!main) return;
        var sections = Array.prototype.slice.call(main.querySelectorAll(':scope > section'));
        sections.forEach(function (section) {
            var heading = section.querySelector(':scope > h2');
            if (!heading) return;
            var year = heading.textContent.trim();
            var details = document.createElement('details');
            details.className = 'news-year publication-year';
            details.open = year === '2026';
            var summary = document.createElement('summary');
            summary.innerHTML = '<span>' + year + '</span><small>publications</small>';
            details.appendChild(summary);
            var items = document.createElement('div');
            items.className = 'news-year-items publication-year-items';
            Array.prototype.slice.call(section.children).forEach(function (child) {
                if (child !== heading) items.appendChild(child);
            });
            details.appendChild(items);
            section.replaceWith(details);
        });
    }());
    </script>
</body>
</html>
