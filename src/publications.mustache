<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" href="theme.css">
    <link rel="stylesheet" href="publications.css">
</head>
<body class="publications-page site-shell">
    {{> header}}
<div id="site-scroll" class="site-scroll" role="region" aria-label="Page content" tabindex="0">
    <div class="site-container">
        <main class="publication-index" aria-label="Publications">
            <h1 class="sr-only">Publications</h1>
            {{#publications}}
            <section class="publication-year" aria-labelledby="year-{{year}}">
                <h2 class="publication-year-title" id="year-{{year}}">{{year}}</h2>
                <div class="publication-rows">
                    {{#papers}}
                    <article class="publication-row{{^media}} publication-row--text{{/media}}" id="{{id}}">
                        {{#media}}
                        {{#src}}
                        <div class="publication-media{{#isLogo}} publication-media--logo{{/isLogo}}"{{#tone}} data-tone="{{.}}"{{/tone}}>
                            <img src="{{.}}" alt="{{alt}}" loading="lazy" decoding="async">
                        </div>
                        {{/src}}
                        {{/media}}
                        <div class="publication-copy">
                            <h3 class="publication-title">{{#paperUrl}}<a href="{{.}}" target="_blank" rel="noopener noreferrer">{{/paperUrl}}{{displayTitle}}{{#paperUrl}}</a>{{/paperUrl}}</h3>
                            <p class="publication-authors">{{authorLine}}</p>
                            {{#displayVenue}}<p class="publication-venue">{{.}}</p>{{/displayVenue}}
                            <div class="publication-actions">
                                {{#paperUrl}}<a href="{{.}}" class="publication-action" target="_blank" rel="noopener noreferrer">Paper <span aria-hidden="true">↗</span></a>{{/paperUrl}}
                                {{#bibtex}}<button type="button" class="publication-action" data-citation="citation-{{id}}" aria-haspopup="dialog">BibTeX</button><template id="citation-{{id}}">{{.}}</template>{{/bibtex}}
                            </div>
                        </div>
                    </article>
                    {{/papers}}
                </div>
            </section>
            {{/publications}}
        </main>
    </div>
    <dialog class="citation-dialog" aria-labelledby="citation-title">
        <div class="citation-dialog-header">
            <h2 id="citation-title">BibTeX</h2>
            <button type="button" class="citation-close" aria-label="Close citation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
        <p class="citation-paper"></p>
        <pre tabindex="0"><code id="citation-code" class="citation-code"></code></pre>
        <div class="citation-actions">
            <button type="button" class="publication-action citation-copy">Copy</button>
            <button type="button" class="publication-action citation-download">Download .bib</button>
            <span class="sr-only citation-status" aria-live="polite"></span>
        </div>
    </dialog>
    {{> footer}}
</div>
    <script src="publications.js"></script>
</body>
</html>
