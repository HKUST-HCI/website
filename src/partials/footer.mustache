<footer class="bg-zinc-700 text-white py-2 mt-8">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <img src="img/logo.svg" class="w-32 logo-on-dark" alt="Human-Computer Interaction Initiative @ HKUST"><img src="img/logo-dark.svg" class="w-32 logo-on-light" alt="" aria-hidden="true">
        <div class="float-right text-center text-xs footer-credits">
            {{#maintainer}}
            <p><small>Authored by
                {{#authors}}
                <a href="{{url}}" class="link person-link">{{name}}</a>
                {{/authors}}
            </small></p>
            <p><small>Maintained by
                {{#maintainers}}
                {{separator}}<a href="{{url}}" class="link person-link">{{name}}</a>
                {{/maintainers}}
            </small></p>
            {{/maintainer}}
            <p><small>&copy; 2022 All rights reserved.</small></p>
        </div>
    </div>
</footer>
